---
import Layout from "../layouts/Layout.astro";
import MosaicoProyectos from "../components/MosaicoProyectos.astro";
import CarruselRenders from "../components/CarruselRenders.astro";
import type { Idioma } from "../i18n/rutas";
import { textos, traducirCategoria } from "../i18n/textos";
import { categoriasDe, obrasTerminadas } from "../lib/proyectos";

interface Props {
  lang?: Idioma;
}
const { lang = "es" } = Astro.props;
const t = textos(lang);

const obras = await obrasTerminadas();
const categorias = categoriasDe(obras);
---

<Layout
  lang={lang}
  titulo={t.proyectos.titulo}
  descripcion={t.proyectos.descripcion}
>
  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera">
        <div><span class="etiqueta">{t.proyectos.etiqueta}</span><h1 class="h2">{t.proyectos.h1}</h1></div>
        <!-- Los filtros necesitan JavaScript: se muestran desde el script; sin él se ven todos los proyectos -->
        <div class="filtros" role="group" aria-label={t.proyectos.filtrosLabel} data-filtros hidden>
          <button type="button" class="chip" aria-pressed="true" data-filtro="">{t.proyectos.todos}</button>
          {categorias.map((c) => <button type="button" class="chip" aria-pressed="false" data-filtro={c}>{traducirCategoria(c, lang)}</button>)}
        </div>
      </div>
      <p
        class="solo-lectores"
        role="status"
        data-resultado
        data-singular={t.proyectos.resultadoSingular}
        data-plural={t.proyectos.resultadoPlural}
      ></p>
      <MosaicoProyectos proyectos={obras} nivel="h2" lang={lang} />
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor">
      <div class="cabecera">
        <div><span class="etiqueta">{t.proyectos.etiquetaEnDesarrollo}</span><h2 class="h2">{t.proyectos.tituloEnDesarrollo}</h2></div>
        <p class="texto-2">{t.proyectos.subtituloEnDesarrollo}</p>
      </div>
      <CarruselRenders lang={lang} />
    </div>
  </section>
</Layout>

<script>
  // Filtra las tarjetas por categoría. Un proyecto con varias categorías aparece al elegir cualquiera de ellas.
  document.addEventListener("astro:page-load", () => {
    const grupo = document.querySelector<HTMLElement>("[data-filtros]");
    const mosaico = document.querySelector<HTMLElement>("[data-mosaico]");
    const resultado = document.querySelector<HTMLElement>("[data-resultado]");
    if (!grupo || !mosaico) return;
    grupo.hidden = false;

    const botones = [...grupo.querySelectorAll<HTMLButtonElement>("[data-filtro]")];
    const tarjetas = [...mosaico.querySelectorAll<HTMLElement>("[data-categorias]")];

    for (const boton of botones) {
      boton.addEventListener("click", () => {
        const filtro = boton.dataset.filtro ?? "";
        let visibles = 0;
        for (const tarjeta of tarjetas) {
          const categorias: string[] = JSON.parse(tarjeta.dataset.categorias ?? "[]");
          const mostrar = !filtro || categorias.includes(filtro);
          tarjeta.hidden = !mostrar;
          if (mostrar) visibles++;
        }
        for (const otro of botones) otro.setAttribute("aria-pressed", String(otro === boton));
        if (resultado) {
          const singular = resultado.dataset.singular ?? "proyecto";
          const plural = resultado.dataset.plural ?? "proyectos";
          resultado.textContent = `${visibles} ${visibles === 1 ? singular : plural}`;
        }
      });
    }
  });
</script>

<style>
  .filtros[hidden] { display: none; }
  .filtros { display: flex; flex-wrap: wrap; gap: var(--e1); }
  .chip { border: 1px solid transparent; border-radius: 999px; padding: 8px 16px; font: 400 14px/1.4 var(--fuente); background: var(--boton-fondo); color: inherit; cursor: pointer; }
  .chip:hover { background: var(--linea); }
  /* El filtro elegido se distingue por borde grueso y marca, no solo por color */
  .chip[aria-pressed="true"] { border: 2px solid var(--vino); padding: 7px 15px; font-weight: 500; }
  .chip[aria-pressed="true"]::before { content: "✓ "; }
</style>
