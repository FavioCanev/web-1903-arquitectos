---
// Foto de un proyecto. Con archivo (src/assets/, ADR 0011) Astro la optimiza: AVIF y WebP, varios tamaños y
// carga diferida. La foto llena todo su recuadro: se recorta lo justo por los bordes, hacia el punto que
// indica `enfoque`, y nunca se estira ni se sale del recuadro. Sin archivo, muestra el recuadro "Pendiente".
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** Texto del recuadro cuando falta la foto. */
  pendiente?: string;
  clase?: string;
  eager?: boolean;
  /** Ancho que ocupa la foto en pantalla, para que el navegador elija el tamaño justo. */
  sizes?: string;
  /** Qué parte de la foto se conserva al recortar, como en `object-position` (por defecto, el centro, un poco arriba). */
  enfoque?: string;
}
const { src, alt, pendiente = "Foto pendiente", clase = "r-4x5", eager = false, sizes = "(max-width: 900px) 100vw, 33vw", enfoque = "50% 40%" } = Astro.props;
---

{src
  ? (
    <div class:list={["marco", clase]}>
      <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? "eager" : "lazy"} style={`object-position:${enfoque}`} />
    </div>
  )
  : <div class:list={["pendiente", clase]}>{pendiente}</div>}

<style>
  .marco { display: block; width: 100%; overflow: hidden; }
  .marco :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
