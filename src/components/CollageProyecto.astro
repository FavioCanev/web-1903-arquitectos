---
import { getImage } from "astro:assets";
import Foto from "./Foto.astro";
import type { Proyecto } from "../lib/proyectos";

interface Props {
  titulo: string;
  fotos: Proyecto["data"]["fotos"];
  /** Semilla por proyecto y sección para variar el ritmo sin cambiar al recargar. */
  semilla?: string;
}
const { titulo, fotos, semilla = titulo } = Astro.props;

const items = await Promise.all(
  fotos.map(async (foto, i) => ({
    foto,
    i,
    grande: foto.src
      ? (await getImage({ src: foto.src, format: "webp", width: Math.min(2000, foto.src.width) })).src
      : undefined,
  })),
);

// Generador determinístico por semilla (FNV-1a + Mulberry32) para que cada proyecto tenga un collage único
// sin cambiar al recargar ni alterar el orden original de las fotografías.
function crearAzar(texto: string): () => number {
  let h = 2166136261;
  for (let i = 0; i < texto.length; i++) {
    h ^= texto.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  let estado = h >>> 0;
  return () => {
    estado = (estado + 0x6d2b79f5) | 0;
    let t = Math.imul(estado ^ (estado >>> 15), 1 | estado);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const azar = crearAzar(semilla);

// 1 foto -> 1 col; 2 a 5 fotos (p. ej. Proceso de 4-5) -> 2 cols; 6 a 12+ fotos -> 3 cols.
const numCols = items.length <= 1 ? 1 : items.length <= 5 ? 2 : 3;
// Reparte las fotos en orden entre las columnas para que cada columna tenga casi la misma cantidad.
const columnas = Array.from({ length: numCols }, (_, c) => items.filter((_, i) => i % numCols === c));
const maxPorCol = Math.max(...columnas.map((col) => col.length), 1);

// Altura base de fila ligeramente distinta por proyecto; en 2 columnas se da algo más de alto para no aplastar tomas horizontales.
const filaDesktop = numCols === 2 ? Math.round(230 + azar() * 34) : Math.round(188 + azar() * 38);

// Respeta la orientación natural (horizontal < 1, vertical >= 1) aplicando una variación acotada (±16 %)
// y topes de proporción para que ninguna foto quede aplastada ni recortada en exceso al compartir columna.
const minHorizontal = numCols === 2 ? 0.84 : 0.72;
const pesos = items.map(({ foto }) => {
  const base = foto.src ? foto.src.height / foto.src.width : 1;
  const factor = 0.86 + azar() * 0.28;
  const crudo = base * factor;
  if (base < 0.95) return Math.min(0.96, Math.max(minHorizontal, crudo)).toFixed(3);
  if (base > 1.05) return Math.min(1.48, Math.max(1.04, crudo)).toFixed(3);
  return Math.min(1.2, Math.max(0.84, crudo)).toFixed(3);
});
const sizes = numCols === 1 ? "(max-width: 900px) 100vw, 80vw" : numCols === 2 ? "(max-width: 900px) 100vw, 40vw" : "(max-width: 900px) 100vw, 27vw";
---

<section class="bloque-collage">
  <h2 class="subtitulo">{titulo}</h2>
  <div class="collage" style={`--cols:${numCols};--filas:${maxPorCol};--fila-px:${filaDesktop}px`}>
    {columnas.map((col) => (
      <div class="collage__col">
        {col.map(({ foto, i, grande }) => (
          <figure class="collage__item" style={`--peso:${pesos[i]}`}>
            {grande ? (
              <button
                type="button"
                class="collage__boton"
                data-ampliar={grande}
                data-alt={foto.alt}
                aria-label={`Ampliar fotografía: ${foto.alt}`}
              >
                <Foto src={foto.src} alt="" enfoque={foto.enfoque} clase="collage__foto" sizes={sizes} />
              </button>
            ) : (
              <Foto src={foto.src} alt={foto.alt} enfoque={foto.enfoque} clase="collage__foto" sizes={sizes} />
            )}
          </figure>
        ))}
      </div>
    ))}
  </div>

  <dialog class="visor" data-visor aria-label="Vista ampliada de la fotografía">
    <div class="visor__marco">
      <button type="button" class="visor__cerrar" data-cerrar aria-label="Cerrar vista ampliada">Cerrar ×</button>
      <img class="visor__img" data-visor-img alt="" />
    </div>
  </dialog>
</section>

<script>
  // Visor de foto ampliada en cada sección de collage; se reinicia al cambiar de página (ADR 0016).
  document.addEventListener("astro:page-load", () => {
    for (const bloque of document.querySelectorAll<HTMLElement>(".bloque-collage")) {
      const visor = bloque.querySelector<HTMLDialogElement>("[data-visor]");
      const img = bloque.querySelector<HTMLImageElement>("[data-visor-img]");
      const cerrar = bloque.querySelector<HTMLButtonElement>("[data-cerrar]");
      if (!visor || !img || !cerrar || visor.dataset.listo) continue;
      visor.dataset.listo = "true";

      bloque.addEventListener("click", (e) => {
        const boton = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-ampliar]");
        if (!boton?.dataset.ampliar) return;
        img.src = boton.dataset.ampliar;
        img.alt = boton.dataset.alt ?? "";
        visor.showModal();
      });

      cerrar.addEventListener("click", () => visor.close());
      visor.addEventListener("click", (e) => {
        if (e.target === visor) visor.close();
      });
      visor.addEventListener("close", () => {
        img.removeAttribute("src");
        img.alt = "";
      });
    }
  });
</script>

<style>
  .bloque-collage { display: grid; gap: var(--e3); width: 100%; }
  .subtitulo {
    font-size: var(--t-xs); font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--vino-2); padding-bottom: var(--e1); border-bottom: 1px solid var(--linea);
  }
  .collage {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 8px;
    /* Altura total proporcional a las filas por columna: todas las columnas estiran al 100 % y cierran en rectángulo */
    height: calc(var(--filas, 3) * clamp(164px, 18vw, var(--fila-px, 210px)));
  }
  .collage__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    min-height: 0;
  }
  .collage__item {
    flex: var(--peso, 1) 1 0;
    min-height: 0;
    margin: 0;
    display: flex;
  }
  .collage__boton {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    display: block;
    overflow: hidden;
  }
  .collage__boton:focus-visible { outline-offset: -3px; position: relative; z-index: 1; }
  .collage__item :global(.collage__foto),
  .collage__item :global(picture) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    aspect-ratio: unset;
  }
  .collage__item :global(picture) { display: block; }
  .collage__boton :global(img) {
    transition: transform var(--dur-media) var(--curva);
  }
  @media (prefers-reduced-motion: no-preference) {
    .collage__boton:hover :global(img),
    .collage__boton:focus-visible :global(img) {
      transform: scale(1.04);
    }
  }

  .visor {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(92vw, 1280px);
    max-height: 90vh;
    overflow: visible;
  }
  .visor::backdrop { background: rgb(20 4 4 / 0.86); }
  .visor__marco {
    position: relative;
    display: grid;
    justify-items: end;
    gap: var(--e2);
  }
  .visor__cerrar {
    min-height: 44px;
    padding: 0 var(--e3);
    border: 0;
    border-radius: 999px;
    background: var(--claro);
    color: var(--vino);
    font: 500 14px/1 var(--fuente);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .visor__cerrar:focus-visible { outline-color: var(--amarillo); }
  .visor__img {
    display: block;
    max-width: min(92vw, 1280px);
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .bloque-collage { width: 100%; }
  }

  @media (max-width: 700px) {
    .collage {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    .collage__item {
      flex: none;
      aspect-ratio: 4 / 3;
    }
  }
</style>
