---
import { getImage } from "astro:assets";
import Foto from "./Foto.astro";
import type { Idioma } from "../i18n/rutas";
import { textos } from "../i18n/textos";
import { altFoto, type Proyecto } from "../lib/proyectos";

interface Props {
  titulo: string;
  fotos: Proyecto["data"]["fotos"];
  lang?: Idioma;
  /** Semilla por proyecto y sección para variar el ritmo sin cambiar al recargar. */
  semilla?: string;
}
const { titulo, fotos, lang = "es", semilla = titulo } = Astro.props;
const t = textos(lang);

const items = await Promise.all(
  fotos.map(async (foto, i) => ({
    foto,
    alt: altFoto(foto, lang),
    i,
    grande: foto.src
      ? (await getImage({ src: foto.src, format: "webp", width: Math.min(2000, foto.src.width) })).src
      : undefined,
  })),
);

// Generador determinístico por semilla (FNV-1a + Mulberry32) para que cada proyecto tenga un collage único
// sin cambiar al recargar ni alterar el orden original de las fotografías.
function crearAzar(texto: string): () => number {
  let h = 2166136261;
  for (let i = 0; i < texto.length; i++) {
    h ^= texto.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  let estado = h >>> 0;
  return () => {
    estado = (estado + 0x6d2b79f5) | 0;
    let t = Math.imul(estado ^ (estado >>> 15), 1 | estado);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const azar = crearAzar(semilla);

// 1 foto -> 1 col; 2 a 5 fotos (p. ej. Proceso de 4-5) -> 2 cols; 6 a 12+ fotos -> 3 cols.
const numCols = items.length <= 1 ? 1 : items.length <= 5 ? 2 : 3;
// Reparte las fotos en orden entre las columnas para que cada columna tenga casi la misma cantidad.
const columnas = Array.from({ length: numCols }, (_, c) => items.filter((_, i) => i % numCols === c));
const maxPorCol = Math.max(...columnas.map((col) => col.length), 1);

// Altura base de fila ligeramente distinta por proyecto; en 2 columnas se da algo más de alto para no aplastar tomas horizontales.
const filaDesktop = numCols === 2 ? Math.round(230 + azar() * 34) : Math.round(188 + azar() * 38);

// Respeta la orientación natural (horizontal < 1, vertical >= 1) aplicando una variación acotada (±16 %)
// y topes de proporción para que ninguna foto quede aplastada ni recortada en exceso al compartir columna.
const minHorizontal = numCols === 2 ? 0.84 : 0.72;
const pesos = items.map(({ foto }) => {
  const base = foto.src ? foto.src.height / foto.src.width : 1;
  const factor = 0.86 + azar() * 0.28;
  const crudo = base * factor;
  if (base < 0.95) return Math.min(0.96, Math.max(minHorizontal, crudo)).toFixed(3);
  if (base > 1.05) return Math.min(1.48, Math.max(1.04, crudo)).toFixed(3);
  return Math.min(1.2, Math.max(0.84, crudo)).toFixed(3);
});
const sizes = numCols === 1 ? "(max-width: 900px) 100vw, 80vw" : numCols === 2 ? "(max-width: 900px) 100vw, 40vw" : "(max-width: 900px) 100vw, 27vw";
---

<section class="bloque-collage">
  <h2 class="subtitulo">{titulo}</h2>
  <div class="collage" style={`--cols:${numCols};--filas:${maxPorCol};--fila-px:${filaDesktop}px`}>
    {columnas.map((col) => (
      <div class="collage__col">
        {col.map(({ foto, alt, i, grande }) => (
          <figure class="collage__item" style={`--peso:${pesos[i]}`}>
            {grande ? (
              <button
                type="button"
                class="collage__boton"
                data-ampliar={grande}
                data-alt={alt}
                aria-label={`${t.collage.ampliarPrefix}${alt}`}
              >
                <Foto src={foto.src} alt="" enfoque={foto.enfoque} clase="collage__foto" sizes={sizes} />
              </button>
            ) : (
              <Foto src={foto.src} alt={alt} enfoque={foto.enfoque} clase="collage__foto" sizes={sizes} />
            )}
          </figure>
        ))}
      </div>
    ))}
  </div>

  <dialog class="visor" data-visor aria-label={t.collage.visorAria}>
    <div class="visor__marco">
      <div class="visor__barra">
        <span class="visor__contador" data-contador aria-live="polite"></span>
        <button type="button" class="visor__cerrar" data-cerrar aria-label={t.collage.cerrarAria}>{t.collage.cerrarTexto}</button>
      </div>
      <div class="visor__escena">
        <button type="button" class="visor__nav visor__nav--prev" data-prev aria-label={t.collage.anterior}>&#8592;</button>
        <img class="visor__img" data-visor-img alt="" />
        <button type="button" class="visor__nav visor__nav--next" data-next aria-label={t.collage.siguiente}>&#8594;</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  // Visor de foto ampliada en cada sección de collage; permite navegar con flechas, teclado y swipe (ADR 0016).
  document.addEventListener("astro:page-load", () => {
    for (const bloque of document.querySelectorAll<HTMLElement>(".bloque-collage")) {
      const visor = bloque.querySelector<HTMLDialogElement>("[data-visor]");
      const img = bloque.querySelector<HTMLImageElement>("[data-visor-img]");
      const cerrar = bloque.querySelector<HTMLButtonElement>("[data-cerrar]");
      const contador = bloque.querySelector<HTMLElement>("[data-contador]");
      const prev = bloque.querySelector<HTMLButtonElement>("[data-prev]");
      const next = bloque.querySelector<HTMLButtonElement>("[data-next]");
      const botones = [...bloque.querySelectorAll<HTMLButtonElement>("[data-ampliar]")];
      if (!visor || !img || !cerrar || !contador || !prev || !next || visor.dataset.listo) continue;
      visor.dataset.listo = "true";

      let indice = 0;
      let solicitudId = 0;
      const cargadas = new Set<string>();
      const precargadas = new Set<string>();
      const multiple = botones.length > 1;
      prev.hidden = !multiple;
      next.hidden = !multiple;
      contador.hidden = !multiple;

      const precargar = (idx: number) => {
        if (botones.length === 0) return;
        const normalizado = ((idx % botones.length) + botones.length) % botones.length;
        const url = botones[normalizado]?.dataset.ampliar;
        if (!url || cargadas.has(url) || precargadas.has(url)) return;
        precargadas.add(url);
        const pre = new Image();
        pre.decoding = "async";
        pre.onload = () => {
          cargadas.add(url);
        };
        pre.src = url;
      };

      const mostrar = (nuevoIndice: number) => {
        if (botones.length === 0) return;
        indice = ((nuevoIndice % botones.length) + botones.length) % botones.length;
        const boton = botones[indice];
        const url = boton?.dataset.ampliar;
        if (!boton || !url) return;
        const alt = boton.dataset.alt ?? "";
        if (multiple) contador.textContent = `${indice + 1} / ${botones.length}`;

        const id = ++solicitudId;
        if (cargadas.has(url)) {
          delete img.dataset.cargando;
          img.src = url;
          img.alt = alt;
        } else {
          // Muestra al instante la miniatura ya cargada del collage mientras descarga la versión de 2000 px.
          const mini = boton.querySelector("img")?.currentSrc;
          if (mini) {
            img.dataset.cargando = "true";
            img.src = mini;
          } else {
            img.removeAttribute("src");
          }
          img.alt = alt;
          const alta = new Image();
          alta.decoding = "async";
          alta.onload = () => {
            cargadas.add(url);
            if (id === solicitudId && visor.open) {
              delete img.dataset.cargando;
              img.src = url;
            }
          };
          alta.src = url;
        }

        if (multiple) {
          precargar(indice + 1);
          precargar(indice - 1);
          precargar(indice + 2);
        }
      };

      bloque.addEventListener("click", (e) => {
        const boton = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-ampliar]");
        if (!boton?.dataset.ampliar) return;
        const idx = botones.indexOf(boton);
        visor.showModal();
        mostrar(idx >= 0 ? idx : 0);
      });

      prev.addEventListener("click", () => mostrar(indice - 1));
      next.addEventListener("click", () => mostrar(indice + 1));

      visor.addEventListener("keydown", (e) => {
        if (!multiple) return;
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          mostrar(indice - 1);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          mostrar(indice + 1);
        }
      });

      let toqueX = 0;
      let toqueY = 0;
      visor.addEventListener("touchstart", (e) => {
        if (e.touches.length !== 1) return;
        toqueX = e.touches[0].clientX;
        toqueY = e.touches[0].clientY;
      }, { passive: true });
      visor.addEventListener("touchend", (e) => {
        if (!multiple || e.changedTouches.length !== 1) return;
        const dx = e.changedTouches[0].clientX - toqueX;
        const dy = e.changedTouches[0].clientY - toqueY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          mostrar(dx < 0 ? indice + 1 : indice - 1);
        }
      }, { passive: true });

      cerrar.addEventListener("click", () => visor.close());
      visor.addEventListener("click", (e) => {
        if (e.target === visor) visor.close();
      });
      visor.addEventListener("close", () => {
        solicitudId++;
        delete img.dataset.cargando;
        img.removeAttribute("src");
        img.alt = "";
      });
    }
  });
</script>

<style>
  .bloque-collage { display: grid; gap: var(--e3); width: 100%; }
  .subtitulo {
    font-size: var(--t-xs); font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--vino-2); padding-bottom: var(--e1); border-bottom: 1px solid var(--linea);
  }
  .collage {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 8px;
    /* Altura total proporcional a las filas por columna: todas las columnas estiran al 100 % y cierran en rectángulo */
    height: calc(var(--filas, 3) * clamp(164px, 18vw, var(--fila-px, 210px)));
  }
  .collage__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    min-height: 0;
  }
  .collage__item {
    flex: var(--peso, 1) 1 0;
    min-height: 0;
    margin: 0;
    display: flex;
  }
  .collage__boton {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    display: block;
    overflow: hidden;
  }
  .collage__boton:focus-visible { outline-offset: -3px; position: relative; z-index: 1; }
  .collage__item :global(.collage__foto),
  .collage__item :global(picture) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    aspect-ratio: unset;
  }
  .collage__item :global(picture) { display: block; }
  .collage__boton :global(img) {
    transition: transform var(--dur-media) var(--curva);
  }
  @media (prefers-reduced-motion: no-preference) {
    .collage__boton:hover :global(img),
    .collage__boton:focus-visible :global(img) {
      transform: scale(1.04);
    }
  }

  .visor {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    width: min(92vw, 1280px);
    max-width: min(92vw, 1280px);
    max-height: 90vh;
    overflow: visible;
  }
  .visor::backdrop { background: rgb(20 4 4 / 0.94); }
  .visor__marco {
    position: relative;
    display: grid;
    justify-items: stretch;
    gap: var(--e2);
  }
  .visor__barra {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--e2);
  }
  .visor__contador {
    grid-column: 2;
    justify-self: center;
    color: var(--claro);
    font-size: var(--t-s);
    font-weight: 500;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }
  .visor__contador[hidden],
  .visor__nav[hidden] {
    display: none;
  }
  .visor__cerrar {
    grid-column: 3;
    justify-self: end;
    min-height: 44px;
    padding: 0 var(--e3);
    border: 0;
    border-radius: 999px;
    background: var(--claro);
    color: var(--vino);
    font: 500 14px/1 var(--fuente);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .visor__cerrar:focus-visible,
  .visor__nav:focus-visible { outline-color: var(--amarillo); }
  .visor__escena {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    gap: var(--e2);
  }
  .visor__nav {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--claro);
    color: var(--vino);
    font-size: 18px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--dur-corta) var(--curva), background-color var(--dur-corta) var(--curva);
  }
  .visor__nav:hover { background: var(--fondo-alt); transform: scale(1.05); }
  .visor__img {
    display: block;
    max-width: min(82vw, 1140px);
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    touch-action: pan-y;
    transition: opacity var(--dur-corta) var(--curva);
  }
  .visor__img[data-cargando] { opacity: 0.92; }

  @media (max-width: 900px) {
    .bloque-collage { width: 100%; }
  }

  @media (max-width: 700px) {
    .collage {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    .collage__item {
      flex: none;
      aspect-ratio: 4 / 3;
    }
    .visor__escena {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .visor__img {
      grid-column: 1 / -1;
      grid-row: 1;
      max-width: 92vw;
      max-height: 70vh;
    }
    .visor__nav--prev { grid-column: 1; grid-row: 2; justify-self: end; }
    .visor__nav--next { grid-column: 2; grid-row: 2; justify-self: start; }
  }
</style>
