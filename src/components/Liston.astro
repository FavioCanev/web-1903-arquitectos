---
// Listón con el patrón de baldosa que se desenrolla con el scroll (ADR 0009; versión 2 en prueba).
// Cuelga de la barra de navegación y baja por la línea del 80 % del ancho (a la derecha, para descargar el lado izquierdo, donde está el texto), como un listón de tela que se desenrolla
// de un rollo que gira, se adelgaza y se acaba justo al final de la página. Es decorativo: los lectores de pantalla lo ignoran.

// Franjas horizontales del cuerpo del rollo: en cada una, el patrón se comprime según la curva del cilindro.
const FRANJAS = 10;
---

<div class="liston" aria-hidden="true" transition:persist="liston">
  <div class="liston__tela"></div>
  <div class="liston__final"></div>
  <div class="liston__rollo">
    <div class="liston__cuerpo">
      {Array.from({ length: FRANJAS }, () => <div class="liston__franja"><div class="liston__vuelta"></div></div>)}
    </div>
    <div class="liston__tapa"><div class="liston__disco"><div class="liston__marca"></div></div></div>
  </div>
</div>

<script>
  // El listón persiste entre páginas (ADR 0012): los oyentes se registran una sola vez
  // y solo se recalcula al llegar a cada página.
  const reducir = matchMedia("(prefers-reduced-motion: reduce)");
  // Dónde arranca el rollo al cargar la página: a tantas baldosas por debajo de la barra de navegación.
  const BALDOSAS_INICIALES = 3.5;
  // Hasta dónde baja el rollo mientras la portada queda quieta: a esta fracción del alto de la pantalla.
  const ADELANTO = 0.72;
  // Diámetro del rollo lleno (px). Se gasta hasta 0 justo cuando sale la última baldosa: no queda sobrante.
  const DIAMETRO_LLENO = 46;
  // Por debajo de este diámetro (px), el rollo ya casi gastado se desvanece de a poco.
  const DIAMETRO_DESVANECER = 12;
  // Proporción de la baldosa del patrón (alto / ancho), tomada del viewBox de patron.svg.
  const PROPORCION_BALDOSA = 687.01367 / 686.48828;
  // Fracción del alto de la última baldosa (patron-final.svg) donde termina su dibujo; debajo queda vacía.
  // El rollo se gasta justo ahí, para que no quede separado de la tela. Medido el 11/11/2026.
  const FIN_DIBUJO_FINAL = 0.837;
  // Separación mínima (px) entre el extremo final del listón y el inicio del pie de página.
  const MARGEN_PIE = 32;

  let pendiente = false;
  let ultimoScroll = scrollY;
  let vaiven = 0;
  let temporizadorQuieto: number | undefined;

  const resto = (a: number, b: number) => ((a % b) + b) % b;

  function actualizar() {
    pendiente = false;
    const liston = document.querySelector<HTMLElement>(".liston");
    if (!liston) return;
    const raiz = document.documentElement.style;

    const barra = document.querySelector<HTMLElement>(".barra-info")?.offsetHeight ?? 0;
    const nav = document.querySelector<HTMLElement>(".nav")?.offsetHeight ?? 0;
    const origen = barra + nav;
    const visible = getComputedStyle(liston).display !== "none";
    const baldosa = Math.round(liston.offsetWidth * PROPORCION_BALDOSA) || 52;

    // Pausa de la portada: mientras el rollo baja desde su inicio hasta el ADELANTO, la portada queda quieta.
    const largoInicial = BALDOSAS_INICIALES * baldosa;
    const largoObjetivo = innerHeight * ADELANTO - nav;
    const pausa = visible && !reducir.matches ? Math.max(0, largoObjetivo - largoInicial) : 0;
    raiz.setProperty("--alto-nav", `${nav}px`);
    raiz.setProperty("--pausa-portada", `${pausa}px`);
    raiz.setProperty("--fin-pausa", `${barra + pausa}px`);

    // Tope antes del pie de página: el listón termina de desenrollarse por encima del footer.
    const pie = document.querySelector<HTMLElement>(".pie");
    const limitePie = pie ? pie.offsetTop : document.documentElement.scrollHeight;
    const techoFin = Math.max(origen + baldosa, limitePie - MARGEN_PIE);
    const hayPausaPortada = Boolean(document.querySelector(".portada-pausa"));
    const pausaEfectiva = hayPausaPortada
      ? pausa
      : Math.min(pausa, Math.max(0, techoFin - origen - largoInicial));
    const disponibleHastaPie = Math.max(baldosa, techoFin - (origen + pausaEfectiva));

    // El largo crece al mismo ritmo que el scroll. Durante la pausa, el listón baja junto con la portada fija.
    const avance = Math.max(0, scrollY - barra);
    const finPagina = Math.max(0, document.documentElement.scrollHeight - innerHeight - barra);
    // Largo total en baldosas completas, para que la última sea entera (la variante sin las piezas de abajo).
    const maximo = Math.max(
      baldosa,
      Math.floor(Math.min(largoInicial + finPagina, disponibleHastaPie) / baldosa) * baldosa,
    );
    const fin = maximo - baldosa * (1 - FIN_DIBUJO_FINAL);
    const largo = reducir.matches ? fin : Math.min(fin, largoInicial + avance);
    const desplazamiento = Math.min(avance, pausaEfectiva);

    // El rollo se adelgaza a lo largo de toda la página: el área de la tela que queda baja con el largo.
    const quedaTela = Math.max(0, 1 - largo / fin);
    const diametro = DIAMETRO_LLENO * Math.sqrt(quedaTela);
    const radio = Math.max(diametro / 2, 0.5); // evita dividir por 0 en el giro

    // Vaivén: el rollo se inclina un poco según la velocidad del scroll y vuelve a su sitio.
    const velocidad = scrollY - ultimoScroll;
    ultimoScroll = scrollY;
    vaiven = reducir.matches ? 0 : Math.max(-6, Math.min(6, vaiven * 0.6 + velocidad * 0.15));

    liston.style.setProperty("--baldosa", `${baldosa}px`);
    liston.style.setProperty("--liston-origen", `${origen + desplazamiento}px`);
    liston.style.setProperty("--liston-largo", `${largo}px`);
    // La última baldosa se desenrolla ya en su versión final: las piezas de abajo nunca llegan a verse.
    liston.style.setProperty("--tela-alto", `${Math.min(largo, maximo - baldosa)}px`);
    liston.style.setProperty("--final-alto", `${Math.max(0, largo - (maximo - baldosa))}px`);
    liston.style.setProperty("--rollo-alto", `${diametro.toFixed(2)}px`);
    liston.style.setProperty("--rollo-opacidad", Math.min(1, diametro / DIAMETRO_DESVANECER).toFixed(3));
    liston.style.setProperty("--vaiven", `${vaiven.toFixed(2)}deg`);
    // El rollo gira lo que se desenrolla: un giro completo por cada vuelta de tela (2πr).
    liston.style.setProperty("--giro", `${((largo / radio) * 180) / Math.PI}deg`);
    liston.dataset.completo = String(largo >= fin);

    // Cuerpo del rollo visto de frente: cada franja muestra la tela con la compresión de su altura en el cilindro,
    // y el dibujo avanza hacia abajo a medida que la tela se desenrolla (como la cinta del video de referencia).
    const franjas = liston.querySelectorAll<HTMLElement>(".liston__franja");
    franjas.forEach((franja, i) => {
      const a = -Math.PI / 2 + (i * Math.PI) / franjas.length;
      const b = -Math.PI / 2 + ((i + 1) * Math.PI) / franjas.length;
      const alto = radio * (Math.sin(b) - Math.sin(a));
      const compresion = Math.max(0.05, Math.cos((a + b) / 2));
      const arco = radio * (a + Math.PI / 2);
      franja.style.height = `${alto}px`;
      const vuelta = franja.firstElementChild as HTMLElement;
      vuelta.style.height = `${alto / compresion + baldosa}px`;
      vuelta.style.transform = `scaleY(${compresion}) translateY(${-resto(arco - largo, baldosa)}px)`;
    });
  }

  function pedirActualizacion() {
    if (!pendiente) {
      pendiente = true;
      requestAnimationFrame(actualizar);
    }
  }

  // Temblor: mientras el scroll se mueve, el rollo tiembla muy levemente; al parar, se calma.
  function marcarMovimiento() {
    const liston = document.querySelector<HTMLElement>(".liston");
    if (!liston || reducir.matches) return;
    liston.dataset.moviendo = "true";
    clearTimeout(temporizadorQuieto);
    temporizadorQuieto = window.setTimeout(() => { liston.dataset.moviendo = "false"; }, 180);
  }

  addEventListener("scroll", pedirActualizacion, { passive: true });
  addEventListener("scroll", marcarMovimiento, { passive: true });
  addEventListener("resize", pedirActualizacion);
  document.addEventListener("astro:page-load", pedirActualizacion);
  // Al dejar de mover el scroll, el rollo vuelve a quedar recto.
  addEventListener("scrollend", () => { vaiven = 0; pedirActualizacion(); });
</script>

<style>
  /* Por encima de los fondos de la portada y de "Proyectos en diseño", y por debajo de los demás contenidos
     (ver las capas en tokens.css y base.css). Excepción a "sin posiciones fijas" (ADR 0009). */
  .liston {
    --liston-ancho: 52px; /* 30 % más grande que los 40 px de la versión 1 */
    --rollo-borde: rgb(40 10 5 / 0.55);
    position: absolute; /* fijo a la página, no a la pantalla: la tela cuelga y no se desliza */
    top: var(--liston-origen, 0px);
    left: calc(80vw - var(--liston-ancho) / 2); /* entre la cuarta y la quinta quinta parte, a la derecha */
    width: var(--liston-ancho);
    height: var(--liston-largo, 0px);
    z-index: var(--capa-liston);
    pointer-events: none;
  }

  /* La parte ya desenrollada: el patrón queda quieto, como una tela que cuelga. Las baldosas miden un número
     entero de px, así el largo total cae justo en el borde de una baldosa. */
  .liston__tela,
  .liston__final {
    --curva-tela: linear-gradient(90deg, rgb(40 10 5 / 0.22), transparent 18%, transparent 82%, rgb(40 10 5 / 0.22));
  }
  .liston__tela {
    height: var(--tela-alto, 100%);
    background: var(--curva-tela), url("/img/patron.svg") top center / 100% var(--baldosa, 52px) repeat-y;
    box-shadow: 3px 0 10px rgb(40 10 5 / 0.25);
  }

  /* La última baldosa es la variante sin las dos piezas de abajo (patron-final.svg, indicada por Favio el
     10/11/2026). Se va mostrando desde arriba mientras se desenrolla, así nunca se ven las piezas que no lleva. */
  .liston__final {
    height: var(--final-alto, 0px);
    overflow: hidden;
    background: url("/img/patron-final.svg") top center / 100% var(--baldosa, 52px) no-repeat;
  }
  /* El sombreado de los costados se recorta a la forma de la baldosa: donde faltan las piezas, no queda sombra suelta. */
  .liston__final::after {
    content: "";
    display: block;
    height: var(--baldosa, 52px);
    background: var(--curva-tela);
    mask: url("/img/patron-final.svg") top center / 100% 100% no-repeat;
  }

  /* El rollo, visto de frente: un cilindro acostado donde se enrolla la tela, en estilo de ilustración plana.
     La tela entra al rollo por arriba; a la derecha se ve la tapa con las vueltas de tela y el tubo de cartón. */
  .liston__rollo {
    position: absolute;
    left: -6px;
    right: -2px;
    top: 100%;
    height: var(--rollo-alto, 46px);
    opacity: var(--rollo-opacidad, 1);
    transform: translateY(-28%) rotate(var(--vaiven, 0deg));
    transition: transform var(--dur-media) var(--curva);
    /* La sombra, los bordes y la tapa se achican con el rollo, para que al final no queden más grandes que él. */
    filter: drop-shadow(0 calc(var(--rollo-alto, 46px) * 0.11) calc(var(--rollo-alto, 46px) * 0.09) rgb(40 10 5 / 0.35));
  }
  .liston[data-completo="true"] .liston__rollo { display: none; }

  /* Cuerpo del cilindro: las franjas con la tela enrollada, y encima la luz y la sombra. */
  .liston__cuerpo {
    position: absolute;
    inset: 0 5px 0 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: min(1.5px, calc(var(--rollo-alto, 46px) * 0.04)) solid var(--rollo-borde);
    border-right: 0;
    /* lado izquierdo curvo: el borde del cilindro visto de frente es una elipse */
    border-top-left-radius: 7px 50%;
    border-bottom-left-radius: 7px 50%;
    background: #f6f1ea;
  }
  .liston__franja { overflow: hidden; flex: none; }
  .liston__vuelta {
    background: url("/img/patron.svg") top center / 100% var(--baldosa, 52px) repeat-y;
    transform-origin: top;
  }
  /* Franjas de luz y sombra del cilindro: brillo arriba, tono medio, sombra y sombra profunda abajo. */
  .liston__cuerpo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgb(255 255 255 / 0.45) 0 16%,
      transparent 16% 46%,
      rgb(40 10 5 / 0.22) 46% 72%,
      rgb(40 10 5 / 0.5) 72% 100%);
  }

  /* Tapa derecha: un disco con las vueltas de tela y el tubo mostaza, achatado en elipse.
     Una marca en el borde gira con el rollo para que se note que da vueltas. */
  .liston__tapa {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--rollo-alto, 46px);
    height: var(--rollo-alto, 46px);
    transform: scaleX(0.26);
    transform-origin: right center;
  }
  .liston__disco {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: calc(var(--rollo-alto, 46px) * 0.11) solid var(--rollo-borde); /* se ve fino al achatarse */
    transform: rotate(var(--giro, 0deg));
    background: radial-gradient(closest-side,
      #2a0b06 0 26%,
      #e49600 26% 46%,
      #00728a 46% 58%,
      #f6f1ea 58% 66%,
      #00728a 66% 78%,
      #fa1103 78% 88%,
      #00728a 88% 100%);
  }
  /* Marca que gira: un tramo corto del borde de la tela. */
  .liston__marca {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 50%;
    height: 10%;
    transform-origin: left center;
    translate: 0 -50%;
    background: linear-gradient(90deg, transparent 52%, #fa1103 52% 100%);
  }

  /* Temblor muy leve mientras baja: unas décimas de grado y medio píxel, para que no se vea rígido. */
  .liston[data-moviendo="true"] .liston__rollo { animation: temblor 0.42s ease-in-out infinite; }
  @keyframes temblor {
    0%, 100% { translate: 0 0; rotate: 0deg; }
    25% { translate: 0 0.5px; rotate: 0.45deg; }
    50% { translate: 0 -0.3px; rotate: -0.3deg; }
    75% { translate: 0 0.4px; rotate: 0.25deg; }
  }

  /* Con "reducir movimiento", sin rollo: el listón se ve completo y quieto. */
  @media (prefers-reduced-motion: reduce) {
    .liston__rollo { display: none; }
  }

  /* Pantallas angostas: se oculta (ADR 0009); el patrón sigue completo en el pie. */
  @media (max-width: 600px) {
    .liston { display: none; }
  }
</style>
