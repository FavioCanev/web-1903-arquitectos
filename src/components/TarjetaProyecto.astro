---
import Foto from "./Foto.astro";
import { datoOPendiente, tienePagina, urlProyecto, type Proyecto } from "../lib/proyectos";

interface Props {
  proyecto: Proyecto;
  /** Clase extra, por ejemplo "parallax". */
  clase?: string;
  /** Solo la foto: el nombre y los datos quedan solo para lectores de pantalla. */
  soloFoto?: boolean;
  /** Nivel del título según el contexto de la página (WCAG 1.3.1). */
  nivel?: "h2" | "h3";
  /** Índice de la foto a mostrar (por defecto, la primera). */
  indiceFoto?: number;
}
const { proyecto, clase, soloFoto = false, nivel = "h3", indiceFoto = 0 } = Astro.props;
const d = proyecto.data;
const foto = d.fotos[indiceFoto] ?? d.fotos[0];
const esRender = d.estado === "render";
// Los renders con vistas reales enlazan a su página; los que aún no tienen imagen quedan como tarjeta sin enlace.
const conEnlace = tienePagina(proyecto);
const Etiqueta = conEnlace ? "a" : "article";
const Titulo = nivel;
const datos = [d.ciudad, d.area ? `${d.area} m²` : "[m²]", datoOPendiente(d.anio, "Año")].join(" · ");
---

<Etiqueta class:list={["tarjeta", clase]} href={conEnlace ? urlProyecto(proyecto) : undefined} aria-label={soloFoto && conEnlace ? d.nombre : undefined} data-categorias={JSON.stringify(d.categorias)}>
  {esRender && <span class="pildora">Render{d.porConfirmar ? " [por confirmar]" : ""}</span>}
  <Foto clase={esRender ? "r-3x2" : "r-4x5"} alt="" pendiente={`${esRender ? "Render" : "Foto"} pendiente · ${d.nombre}`} src={foto?.src} enfoque={foto?.enfoque} />
  <span class:list={["tarjeta__datos", { "solo-lectores": soloFoto }]}>{datos}</span>
  <div class:list={["tarjeta__titulo", { "solo-lectores": soloFoto }]}><Titulo class="h3">{d.nombre}</Titulo><span class="tarjeta__tipo">{d.tipo}</span></div>
</Etiqueta>

<style>
  .tarjeta { display: grid; gap: var(--e2); text-decoration: none; min-width: 0; align-content: start; }
  .tarjeta[hidden] { display: none; }
  a.tarjeta :global(.marco img) { transition: transform var(--dur-media) var(--curva); }
  a.tarjeta .h3 {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    transition: text-decoration-color var(--dur-corta) var(--curva);
  }
  a.tarjeta:hover .h3,
  a.tarjeta:focus-visible .h3 { text-decoration-color: var(--naranja); }
  a.tarjeta:hover :global(.marco img),
  a.tarjeta:focus-visible :global(.marco img) { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    a.tarjeta:hover :global(.marco img),
    a.tarjeta:focus-visible :global(.marco img) { transform: none; }
  }
  .tarjeta__datos { font-size: var(--t-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--vino-2); }
  .tarjeta__titulo { display: grid; gap: 4px; }
  .tarjeta__tipo { font-size: var(--t-s); color: var(--vino-2); }
</style>
