---
import { enlaceWhatsapp } from "../lib/whatsapp";
---

<a class="whatsapp" href={enlaceWhatsapp()} target="_blank" rel="noopener">WhatsApp<span class="solo-lectores"> (se abre en otra pestaña)</span></a>

<style>
  /* Una de las dos excepciones a "sin posiciones fijas" (ADR 0009) */
  .whatsapp {
    position: fixed; right: 24px; bottom: 24px; z-index: var(--capa-whatsapp);
    background: var(--naranja); color: var(--vino); border-radius: 999px; padding: 14px 20px;
    font-weight: 500; text-decoration: none; font-size: 15px;
    transition: transform var(--dur-corta) var(--curva);
  }
  .whatsapp:hover { transform: translateY(-2px); }
  @media (max-width: 900px) { .whatsapp { right: 16px; bottom: 16px; } }
</style>
