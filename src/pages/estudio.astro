---
import Layout from "../layouts/Layout.astro";
import Foto from "../components/Foto.astro";
import renderShowroom from "../assets/showroom.jpg";
import { enlaceComoLlegar } from "../config";

const equipo = ["Arq. Jorge Muñoz", "Arq. Carla Llerena", "Arq. Loren Bazán"]; // solo nombres, sin cargos
---

<Layout
  titulo="Estudio — 1903 Arquitectos"
  descripcion="Diecinueve cero tres: un estudio de Cajamarca con obra construida. Conoce nuestra historia, al equipo y el showroom de materiales."
>
  <section class="seccion">
    <div class="contenedor">
      <div class="historia">
        <div>
          <span class="etiqueta">Estudio</span>
          <h1 class="h2">Diecinueve cero tres</h1>
          <p class="texto-2 historia__intro">1903 (pronunciado "diecinueve cero tres") nace de la unión de dos socios y el homenaje a nuestras raíces. El nombre surge al combinar los últimos dígitos de las casas familiares donde crecimos: el 19 (del Jr. Amazonas 919 en Cajamarca, hogar de Jorge) y el 03 (de la calle Amazonas 103 en Arequipa, hogar de Carla). Es el punto de partida que nos recuerda de dónde venimos y el valor de construir espacios con identidad propia.</p>
        </div>
        <div class="textos">
          <div class="bloque"><span class="etiqueta">Misión</span><p>Diseñamos espacios bellos y funcionales que respetan la identidad local y responden a lo que cada cliente necesita.</p></div>
          <div class="bloque"><span class="etiqueta">Visión</span><p>Ser un estudio referente de arquitectura y diseño de interiores en el Perú, reconocido por transformar espacios en experiencias memorables con sentido cultural y social.</p></div>
          <div class="bloque"><span class="etiqueta">Propósito</span><p>Transformar la manera en que se habita el espacio en el Perú, creando arquitectura que conecta emocionalmente con las personas, honra nuestra cultura y mejora la calidad de vida de quienes la viven.</p></div>
        </div>
      </div>
      <h2 class="solo-lectores">Equipo</h2>
      <ul class="equipo">
        {equipo.map((nombre) => (
          <li><div class="pendiente r-4x5">Retrato pendiente</div><h3 class="h3">{nombre}</h3></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor showroom">
      <div class="showroom__media">
        <span class="pildora showroom__marca">Render</span>
        <Foto
          src={renderShowroom}
          alt="Render interior del showroom de materiales y oficinas en mezzanine de 1903 Arquitectos, con exhibidores de acabados, mobiliario central y techo de estructura metálica"
          clase="r-4x5 showroom__foto"
          sizes="(max-width: 900px) 100vw, 45vw"
          enfoque="50% 50%"
        />
      </div>
      <div class="showroom__texto">
        <span class="etiqueta">Showroom</span>
        <h2 class="h2">Ven a ver los materiales en persona</h2>
        <p class="texto-2 showroom__nota">Abre a inicios de diciembre, en el mismo espacio del estudio y con el mismo horario. [Fecha exacta y materiales por confirmar.]</p>
        <a class="boton boton--secundario" href={enlaceComoLlegar} target="_blank" rel="noopener">Cómo llegar<span class="solo-lectores"> (se abre en otra pestaña)</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .historia { display: grid; grid-template-columns: repeat(var(--columnas), minmax(0, 1fr)); gap: var(--e6) var(--canal); align-items: start; }
  .historia > div { grid-column: span 6; }
  .historia__intro { margin-top: var(--e3); max-width: 46ch; }
  .textos { display: grid; gap: var(--e6); }
  .bloque { display: grid; gap: var(--e1); padding-top: var(--e3); border-top: 1px solid var(--linea); }
  .equipo { display: grid; grid-template-columns: repeat(var(--columnas), minmax(0, 1fr)); gap: var(--e6) var(--canal); list-style: none; padding: 0; margin: var(--e12) 0 0; }
  .equipo li { grid-column: span 4; display: grid; gap: var(--e2); min-width: 0; }
  .showroom { display: grid; grid-template-columns: repeat(var(--columnas), minmax(0, 1fr)); gap: var(--e6) var(--canal); align-items: center; }
  .showroom__media { grid-column: span 5; }
  .showroom__texto { grid-column: span 7; }
  .showroom__foto { border-radius: var(--radio); }
  .showroom__marca { margin-bottom: var(--e2); }
  .showroom__nota { margin: var(--e3) 0; }
  @media (max-width: 900px) {
    .historia > div, .showroom__media, .showroom__texto { grid-column: 1 / -1; }
    .equipo li { grid-column: span 6; }
  }
  @media (max-width: 600px) {
    .equipo li { grid-column: 1 / -1; }
  }
</style>
