---
import Layout from "../layouts/Layout.astro";
import GrillaFija from "../components/GrillaFija.astro";
import CarruselRenders from "../components/CarruselRenders.astro";
import { estudio } from "../config";
import { enlaceWhatsapp } from "../lib/whatsapp";
import Foto from "../components/Foto.astro";
import { obrasTerminadas, urlProyecto } from "../lib/proyectos";

const obras = await obrasTerminadas();
const destacado = obras.find((p) => p.data.destacado);
const delInicio = obras.filter((p) => p.data.inicio);
const fotoPortada = destacado?.data.fotos[destacado.data.portada ?? 0];
const hayFotoPortada = Boolean(fotoPortada?.src && destacado);
---

<Layout
  titulo="1903 Arquitectos — Arquitectura e interiorismo comercial en Cajamarca"
  descripcion="Estudio de arquitectura e interiorismo en Cajamarca. Diseñamos y construimos cafés, restaurantes, locales comerciales y viviendas con identidad cajamarquina."
>
  <!-- La portada queda quieta mientras el listón baja desde la barra; --pausa-portada lo calcula Liston.astro -->
  <div class:list={["portada-pausa", "liston-sobre", { "portada-pausa--con-foto": hayFotoPortada }]}>
  <!-- Dos capas fijas: el fondo (la foto) queda por debajo del listón y el contenido, por encima -->
  <div class="pendiente inicio__fondo" aria-hidden={hayFotoPortada ? undefined : "true"}>
    {fotoPortada?.src && destacado && (
      <a href={urlProyecto(destacado)} aria-label={`Ver el proyecto ${destacado.data.nombre}`}>
        <Foto src={fotoPortada.src} alt="" clase="inicio__imagen" eager sizes="100vw" enfoque={fotoPortada.enfoque} />
      </a>
    )}
  </div>
  <section class="inicio liston-sobre" aria-label="Proyecto destacado">
    <div class="pendiente inicio__foto">
      <div class="inicio__contenido">
        {!fotoPortada?.src && <span class="inicio__nota parallax-portada sobre-liston">Foto pendiente · {destacado?.data.nombre}</span>}
        <h1 class="h1 parallax-portada sobre-liston">{estudio.lema}</h1>
        <div class="botones sobre-liston">
          <a class="boton boton--primario" href="/proyectos/">Ver proyectos</a>
          <a class="boton boton--secundario" href={enlaceWhatsapp()}>Escríbenos por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
  </div>

  <GrillaFija proyectos={delInicio} />

  <section class="seccion seccion--alt liston-sobre">
    <div class="contenedor sobre-liston">
      <div class="cabecera">
        <div><span class="etiqueta">En desarrollo</span><h2 class="h2">Proyectos en diseño</h2></div>
        <p class="texto-2">Visualizaciones de proyectos que todavía no se construyen.</p>
      </div>
      <CarruselRenders />
    </div>
  </section>
</Layout>

<style>
  /* Portada fija durante la pausa. Fondo y contenido comparten la misma celda y quedan fijos juntos;
     el sticky crea su propia capa, por eso son dos: el fondo debajo del listón y el contenido encima. */
  .portada-pausa { display: grid; }
  .portada-pausa > .inicio__fondo,
  .portada-pausa > .inicio { grid-area: 1 / 1; position: sticky; top: var(--alto-nav, 0px); }
  .inicio__fondo { z-index: 0; border-radius: 0; padding: 0; contain: size; } /* la foto llena el espacio que da la portada, no lo agranda */
  .inicio__fondo :global(.inicio__imagen) { width: 100%; height: 100%; }
  /* La foto de la portada es un enlace al proyecto. El contenido va encima, así que deja pasar los clics
     (solo los botones los reciben) para que un clic en la foto llegue al enlace. */
  .inicio__fondo a { display: grid; width: 100%; height: 100%; }
  .inicio__fondo a > :global(*), .inicio__fondo a::after { grid-area: 1 / 1; }
  /* Velo oscuro plano sobre la foto (negro al 40 %, sin degradado): da contraste al titular blanco (WCAG 2.2 AA, ADR 0013) */
  .inicio__fondo a::after { content: ""; background: rgb(0 0 0 / 0.4); pointer-events: none; }
  .inicio__fondo a:focus-visible { outline-offset: -6px; }
  .inicio { pointer-events: none; }
  .inicio .botones { pointer-events: auto; }
  .inicio { z-index: var(--capa-contenido); --velo: var(--velo-pendiente); } /* el velo toma el color del fondo de la portada */
  .inicio .inicio__foto { background: transparent; }
  /* Espacio de la pausa: el sticky solo se mueve dentro del contenido del contenedor, no en su relleno. */
  .portada-pausa::after { content: ""; grid-row: 2; height: var(--pausa-portada, 0px); }
  .inicio__foto {
    min-height: clamp(520px, 78vh, 820px); border-radius: 0; align-content: end; justify-items: start;
    text-align: left; padding: var(--e8) var(--margen);
  }
  .inicio__contenido { display: grid; gap: var(--e3); max-width: 760px; text-transform: none; letter-spacing: normal; font-weight: 400; }
  /* El titular de la portada va sin el rectángulo del velo: ese rectángulo es solo para el texto que cruza el listón.
     Solo pasa a blanco cuando hay foto (con su velo oscuro); si falta la foto, conserva el vino sobre el fondo pendiente. */
  .inicio__contenido h1 { background: none; box-shadow: none; }
  .portada-pausa--con-foto .inicio__contenido h1 { color: var(--claro); }
  .inicio__nota { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--vino-2); }
</style>
