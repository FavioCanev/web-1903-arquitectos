---
import { ClientRouter } from "astro:transitions";
import "@fontsource/jost/latin-400.css";
import "@fontsource/jost/latin-500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/parallax.css";
import BarraInfo from "../components/BarraInfo.astro";
import Nav from "../components/Nav.astro";
import Pie from "../components/Pie.astro";
import Liston from "../components/Liston.astro";

interface Props {
  titulo: string;
  descripcion: string;
  /** Para la página 404: que no aparezca en Google. */
  noindex?: boolean;
}
const { titulo, descripcion, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Liston />
    <BarraInfo />
    <Nav />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <script>
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLImageElement>(".foto-esqueleto img").forEach((img) => {
          const caja = img.closest<HTMLElement>(".foto-esqueleto");
          if (!caja) return;
          if (img.complete) {
            caja.dataset.cargada = "1";
          } else {
            const marcar = () => { caja.dataset.cargada = "1"; };
            img.addEventListener("load", marcar, { once: true });
            img.addEventListener("error", marcar, { once: true });
          }
        });
      });
    </script>
  </body>
</html>
