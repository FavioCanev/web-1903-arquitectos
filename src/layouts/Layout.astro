---
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import "@fontsource/jost/latin-400.css";
import "@fontsource/jost/latin-500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/parallax.css";
import { estudio } from "../config";
import { alternarRuta, limpiarBase, type Idioma } from "../i18n/rutas";
import { ARCHIVOS_LOGO, RANGOS_TEMPORADA } from "../lib/temporada";
import { textos } from "../i18n/textos";
import portadaDefecto from "../assets/proyectos/estacion-de-servicio-labanda/02.jpg";
import BarraInfo from "../components/BarraInfo.astro";
import Nav from "../components/Nav.astro";
import Pie from "../components/Pie.astro";
import Liston from "../components/Liston.astro";

interface Props {
  titulo: string;
  descripcion: string;
  lang?: Idioma;
  /** Ruta equivalente en el idioma contrario cuando difiere de la tabla estándar. */
  alterno?: string;
  /** Para la página 404: que no aparezca en Google. */
  noindex?: boolean;
  /** Imagen para vistas previas al compartir enlaces (Open Graph / Twitter). */
  imagen?: string;
  /** Tipo Open Graph de la página. */
  tipo?: "website" | "article";
  /** Datos estructurados Schema.org (JSON-LD). */
  jsonLd?: Record<string, unknown>;
}
const { titulo, descripcion, lang = "es", alterno, noindex = false, imagen, tipo = "website", jsonLd } = Astro.props;
const t = textos(lang);
const baseUrl = import.meta.env.BASE_URL;
const rutaLimpia = limpiarBase(Astro.url.pathname, baseUrl);
const urlEs = lang === "es" ? rutaLimpia : alterno ?? alternarRuta(Astro.url.pathname, "es", baseUrl);
const urlEn = lang === "en" ? rutaLimpia : alterno ?? alternarRuta(Astro.url.pathname, "en", baseUrl);

const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imagenOg = imagen ?? (await getImage({ src: portadaDefecto, format: "jpeg", width: 1200 })).src;
const imagenOgUrl = Astro.site ? new URL(imagenOg, Astro.site).href : imagenOg;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && !noindex && (
      <>
        <link rel="alternate" hreflang="es" href={new URL(urlEs, Astro.site).href} />
        <link rel="alternate" hreflang="en" href={new URL(urlEn, Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(urlEs, Astro.site).href} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={t.meta.ogLocaleAlterno} />
    <meta property="og:site_name" content={estudio.nombre} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imagenOgUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOgUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
    <script
      type="application/json"
      is:inline
      data-temporada-config
      set:html={JSON.stringify({ rangos: RANGOS_TEMPORADA, archivos: ARCHIVOS_LOGO, zona: estudio.zonaHoraria })}
    />
    <script is:inline>
      (() => {
        const nodoCfg = document.querySelector("script[data-temporada-config]");
        if (!nodoCfg) return;
        const cfg = JSON.parse(nodoCfg.textContent || "{}");
        function detectarTemporada() {
          const p = new URLSearchParams(location.search).get("temporada");
          const clave = p ? p.trim().toLowerCase() : "";
          if (clave && cfg.archivos && Object.prototype.hasOwnProperty.call(cfg.archivos, clave)) return clave;
          const partes = new Intl.DateTimeFormat("en-US", {
            timeZone: cfg.zona,
            month: "numeric",
            day: "numeric",
          }).formatToParts(new Date());
          const mes = Number((partes.find((x) => x.type === "month") || {}).value);
          const dia = Number((partes.find((x) => x.type === "day") || {}).value);
          const codigo = mes * 100 + dia;
          for (let i = 0; i < (cfg.rangos || []).length; i += 1) {
            const r = cfg.rangos[i];
            if (codigo >= r.inicioMes * 100 + r.inicioDia && codigo <= r.finMes * 100 + r.finDia) {
              return r.temporada;
            }
          }
          return "normal";
        }
        function aplicarLogosTemporada() {
          const temporada = detectarTemporada();
          const mapa = cfg.archivos || {};
          const archivo = mapa[temporada] || mapa.normal;
          if (!archivo) return;
          document.querySelectorAll("img[data-logo-temporada]").forEach((img) => {
            const actual = img.getAttribute("src") || "";
            const siguiente = /logo-h-[^/]+\.svg$/i.test(actual)
              ? actual.replace(/logo-h-[^/]+\.svg$/i, archivo)
              : "/img/" + archivo;
            if (actual !== siguiente) img.setAttribute("src", siguiente);
          });
        }
        window["__aplicarLogosTemporada"] = aplicarLogosTemporada;
        if (!window["__logosTemporadaListo"]) {
          window["__logosTemporadaListo"] = true;
          document.addEventListener("astro:after-swap", aplicarLogosTemporada);
          document.addEventListener("astro:page-load", aplicarLogosTemporada);
        }
      })();
    </script>
  </head>
  <body id="arriba">
    <a class="saltar" href="#contenido">{t.meta.saltar}</a>
    <Liston />
    <BarraInfo lang={lang} urlEs={urlEs} urlEn={urlEn} />
    <Nav lang={lang} />
    <script is:inline>window["__aplicarLogosTemporada"]?.();</script>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie lang={lang} />
    <script is:inline>window["__aplicarLogosTemporada"]?.();</script>
    <script>
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLImageElement>(".foto-esqueleto img").forEach((img) => {
          const caja = img.closest<HTMLElement>(".foto-esqueleto");
          if (!caja) return;
          if (img.complete) {
            caja.dataset.cargada = "1";
          } else {
            const marcar = () => { caja.dataset.cargada = "1"; };
            img.addEventListener("load", marcar, { once: true });
            img.addEventListener("error", marcar, { once: true });
          }
        });
      });
    </script>
  </body>
</html>
